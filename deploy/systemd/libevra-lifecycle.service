[Unit]
Description=Libevra archived-ledger cleanup (365-day tombstone job)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/libevra/deploy
# The script uses pg_try_advisory_lock, so overlapping runs exit without doing anything.
ExecStart=/usr/bin/docker compose -f /srv/libevra/deploy/docker-compose.prod.yml exec -T api pnpm --filter @libellum/api lifecycle:purge

# A failed run is visible in the journal and makes the unit fail; the next daily timer
# retries the same due archives. No silent, endless retention is allowed.
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
