# Test-only relay environment. Copy to deploy/.s13i-test.relay.env (mode 600, gitignored).
# Use ONLY the test write CAM identity and test prefixes.
DATABASE_URL=postgresql://s13i_test:CHANGE_ME_TEST_DB@db:5432/libevra_s13i_test?schema=public
CRITICAL_EVENT_REMOTE=cos
CRITICAL_EVENT_COS_BUCKET=libevra-backup-1505362843
CRITICAL_EVENT_COS_REGION=ap-hongkong
CRITICAL_EVENT_COS_ENDPOINT=cos.ap-hongkong.myqcloud.com
CRITICAL_EVENT_COS_SECRET_ID=CHANGE_ME_TEST_WRITE_SECRET_ID
