# Test-only DB/bootstrap values for the isolated S13-I Docker stack.
# This file is NOT automatically read by Docker Compose; export it in the current shell:
#   set -a; . ./deploy/.s13i-test.db.env; set +a
# Copy to deploy/.s13i-test.db.env (mode 600, gitignored). Use test-only values.
S13I_TEST_DB_USER=s13i_test
S13I_TEST_DB_PASSWORD=CHANGE_ME_TEST_DB_PASSWORD
S13I_TEST_DB_NAME=libevra_s13i_test
S13I_TEST_DATABASE_URL=postgresql://s13i_test:CHANGE_ME_TEST_DB_PASSWORD_PERCENT_ENCODED@db:5432/libevra_s13i_test?schema=public
