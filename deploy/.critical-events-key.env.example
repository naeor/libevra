# S13-I event encryption key ring. Keep this file OFF Git, mode 600, server only.
# It is loaded only by the relay container and the checkpoint backup service.
# The ordinary API container does NOT load this file and must never receive the event key.
#
# Format: CRITICAL_EVENT_KEY is either 64 hex chars or base64 for exactly 32 bytes.
# Initial production key id is v1. Never rotate by deleting the old key immediately.
CRITICAL_EVENT_KEY=CHANGE_ME_64_HEX_OR_BASE64_32_BYTES
CRITICAL_EVENT_KEY_ID=v1
# CRITICAL_EVENT_PREVIOUS_KEYS=v1:<old-key>,v0:<older-key>
