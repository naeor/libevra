# S13-I relay-only secrets. Copy to `deploy/.critical-events-relay.env` (mode 600).
# This identity must have PutObject/HeadObject ONLY on the dedicated prefix — never DeleteObject,
# and never GetObject/ListBucket. A separate restore identity (kept off the server) reads it.
CRITICAL_EVENT_REMOTE=cos
CRITICAL_EVENT_COS_BUCKET=libevra-backup-CHANGE_ME
CRITICAL_EVENT_COS_REGION=ap-hongkong
CRITICAL_EVENT_COS_SECRET_ID=CHANGE_ME_WRITE_ONLY_SUB_ACCOUNT
CRITICAL_EVENT_COS_SECRET_KEY=CHANGE_ME
# 32 random bytes, base64 or 64 hex chars. Store a copy in the offline disaster-recovery safe:
# losing it makes every critical-event object unreadable.
CRITICAL_EVENT_KEY=CHANGE_ME_BASE64_32_BYTES
