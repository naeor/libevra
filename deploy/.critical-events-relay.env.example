# S13-I relay-only secrets. Copy to `deploy/.critical-events-relay.env` (mode 600).
# This identity must have PutObject/HeadObject ONLY on the dedicated event prefix — never DeleteObject,
# and never GetObject/ListBucket. A separate restore identity (kept off the server) reads it.
# The event bucket is distinct from the S12-C backup bucket.
CRITICAL_EVENT_REMOTE=cos
CRITICAL_EVENT_COS_BUCKET=libevra-critical-1505362843
CRITICAL_EVENT_COS_REGION=ap-hongkong
CRITICAL_EVENT_COS_SECRET_ID=CHANGE_ME_WRITE_ONLY_SUB_ACCOUNT
CRITICAL_EVENT_COS_SECRET_KEY=CHANGE_ME
# Optional; defaults to cos.<region>.myqcloud.com
# CRITICAL_EVENT_COS_ENDPOINT=cos.ap-hongkong.myqcloud.com
# 32 random bytes live in the separate `.critical-events-key.env` (mode 600), loaded only by the
# relay container and the checkpoint backup service. Do not put the event key in this file.
# Key versioning: new envelopes carry this id. On rotation, keep old keys in
# `.critical-events-key.env` as CRITICAL_EVENT_PREVIOUS_KEYS=v1:<old key>,v0:<older key>.
# Normal wake-up is PostgreSQL LISTEN/NOTIFY; polling is only compensation.
CRITICAL_EVENTS_RELAY_POLL_MS=1000
CRITICAL_EVENTS_RELAY_RECONNECT_MS=5000
