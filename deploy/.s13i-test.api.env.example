# Test-only API environment for the isolated S13-I Docker stack.
# Copy to deploy/.s13i-test.api.env (mode 600, gitignored). Do not point at production DB.
DATABASE_URL=postgresql://s13i_test:CHANGE_ME_TEST_DB@db:5432/libevra_s13i_test?schema=public
SESSION_SECRET=CHANGE_ME_TEST_SESSION_SECRET
# API does NOT receive COS credentials.
CRITICAL_EVENTS_MODE=relay
