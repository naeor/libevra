# S13-I restore-side (read-only) COS identity. Keep OFF the production server.
# Copy to `deploy/.critical-events-restore.env`, mode 600, only on the recovery machine.
CRITICAL_EVENT_COS_RESTORE_ID=CHANGE_ME_READ_ONLY_SUB_ACCOUNT
CRITICAL_EVENT_COS_RESTORE_KEY=CHANGE_ME
CRITICAL_EVENT_COS_BUCKET=libevra-backup-CHANGE_ME
CRITICAL_EVENT_COS_REGION=ap-hongkong
# CRITICAL_EVENT_COS_ENDPOINT=cos.ap-hongkong.myqcloud.com
# CRITICAL_EVENT_KEY=CHANGE_ME_BASE64_32_BYTES
