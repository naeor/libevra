{
  "name": "libevra",
  "version": "0.1.0",
  "private": true,
  "description": "Libevra - an independent, non-commercial personal finance project; not publicly released",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @libellum/web dev",
    "dev:api": "pnpm --filter @libellum/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:build": "node tools/check-build.mjs",
    "check:docs": "node tools/check-links.mjs && node tools/doc-audit.mjs",
    "check:links": "node tools/check-links.mjs",
    "check:status": "node tools/check-status.mjs",
    "check:delivery": "pnpm --filter @libellum/shared --filter @libellum/api typecheck && node tools/check-build.mjs && pnpm check:docs && pnpm check:status && pnpm i18n:scan",
    "i18n:scan": "node tools/i18n-scan.mjs",
    "agent:brief": "node tools/agent-brief.mjs",
    "test": "pnpm -r test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "dev:cert": "node tools/make-dev-cert.mjs",
    "invite:create": "pnpm --filter @libellum/api invite:create",
    "invite:batch": "pnpm --filter @libellum/api invite:batch",
    "admin:grant": "pnpm --filter @libellum/api admin:grant",
    "admin:revoke": "pnpm --filter @libellum/api admin:revoke",
    "admin:list": "pnpm --filter @libellum/api admin:list",
    "admin:allow": "pnpm --filter @libellum/api admin:allow",
    "admin:disallow": "pnpm --filter @libellum/api admin:disallow",
    "set:password": "pnpm --filter @libellum/api set:password",
    "check:db": "pnpm --filter @libellum/api check:db",
    "docs:build": "node tools/build-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
