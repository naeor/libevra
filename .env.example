# ============================================================
# 环境变量模板
# 用法：复制成 .env 再填入真实值。.env 永远不进 Git。
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---- 数据库（PostgreSQL 17）----
# 本地开发：原生安装的 PostgreSQL 17，默认端口 5432
DATABASE_URL="postgresql://ledger:CHANGE_ME@127.0.0.1:5432/ledger_dev?schema=public"
# 跑测试用的独立库（测试会清库，绝不要指向开发库）
TEST_DATABASE_URL="postgresql://ledger:CHANGE_ME@127.0.0.1:5432/ledger_test?schema=public"

# ---- 会话签名密钥 ----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---- 服务 ----
NODE_ENV=development
API_PORT=3000
# 监听地址。本地开发保持 127.0.0.1：只允许本机访问，也不会触发 Windows 防火墙弹窗。
# 生产环境（容器内）需要改成 0.0.0.0 才能被反向代理访问。
API_HOST=127.0.0.1
WEB_ORIGIN="http://localhost:5173"

# ---- 注册规则（S14-A）----
# invite：注册需要邀请码（默认；当前生产规则）。open：允许直接注册，页面自动显示三个字段。
# ⚠️ open 需要所有者明确批准；公开注册的名额/风控在 S14-D，未实现前不要把生产改成 open。
REGISTRATION_MODE=invite

# ---- 小票图片上传 ----
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10

# ---- 演示账号（只读，S6 阶段使用）----
DEMO_USERNAME="demo"
DEMO_PASSWORD=""

# ---- S13-I 关键状态登记簿（本地开发/测试）----
# 生产 API 不持有 COS 凭据：设置 CRITICAL_EVENTS_MODE=relay，等待独立 relay 服务确认。
# 本地开发可用 inline + 临时目录；不要把生产密钥写进这里。
CRITICAL_EVENTS_MODE=inline
CRITICAL_EVENTS_RELAY_TIMEOUT_MS=8000
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 生产必须把同一把密钥保存在离线灾难恢复保险箱；丢失后历史事件无法解密。
# CRITICAL_EVENT_KEY=""
# CRITICAL_EVENT_REMOTE_DIR="./.critical-events-dev"
