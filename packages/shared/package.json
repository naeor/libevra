{
  "name": "@libellum/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, schemas and pure helpers shared by the Libevra web app and API",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./workbench/configuration": {
      "types": "./src/workbench/configuration.ts",
      "default": "./src/workbench/configuration.ts"
    },
    "./workbench/legacyDefault": {
      "types": "./src/workbench/legacyDefault.ts",
      "default": "./src/workbench/legacyDefault.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./analysis/layout": {
      "types": "./src/analysis/layout/index.ts",
      "default": "./src/analysis/layout/index.ts"
    },
    "./analysis/catalog": {
      "types": "./src/analysis/analysisCatalog.ts",
      "default": "./src/analysis/analysisCatalog.ts"
    },
    "./analysis/advanced": {
      "types": "./src/analysis/advanced/index.ts",
      "default": "./src/analysis/advanced/index.ts"
    },
    "./workbench/envelope": {
      "types": "./src/workbench/envelope.ts",
      "default": "./src/workbench/envelope.ts"
    },
    "./workbench/pipeline": {
      "types": "./src/workbench/pipeline.ts",
      "default": "./src/workbench/pipeline.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
